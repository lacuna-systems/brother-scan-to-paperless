# Required scanner settings
PRINTER_IP=192.168.1.50
HOST_IP=192.168.1.10
SCANNER_MODEL=DCP-L2540DW

# Delivery mode: consume or api
DELIVERY_MODE=consume

# Consume mode includes the bind-mount override. API mode uses compose.yaml.
COMPOSE_FILE=compose.yaml:compose.consume.yaml

# Consume mode: bind this host path to Paperless's consume directory.
# API mode: leave this empty and set COMPOSE_FILE=compose.yaml.
PAPERLESS_CONSUME_DIR=/path/to/paperless/consume

# API mode settings (leave empty in consume mode)
PAPERLESS_URL=
PAPERLESS_API_TOKEN=
PAPERLESS_API_TOKEN_FILE=
PAPERLESS_API_TIMEOUT=60
PAPERLESS_ALLOW_INSECURE_HTTP=false
# Comma-separated Paperless tag IDs to assign to every upload, e.g. 3,14
PAPERLESS_TAGS=

# Optional Docker settings (defaults shown)
# Override these image references with a versioned tag or digest to pin them.
BRSCAN4_IMAGE=ghcr.io/zshel/brother-scan-to-paperless:brscan4
BRSCAN5_IMAGE=ghcr.io/zshel/brother-scan-to-paperless:brscan5
SCANNER_NAME=BROTHER
DISPLAY_NAME=Paperless
LISTEN_PORT=54925
RESOLUTION=300
FORMAT=tiff
REGISTER_INTERVAL=300
SCAN_TIMEOUT=120
